# Ignore everything heavy / non-reproducible in the Docker context
.git/
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Local dev artifacts
.DS_Store
*.log
artifacts/
.kaggle_mining/
catboost_info/

# Raw data — mounted at runtime, NOT baked into image
MTPNet/data/
old/data/
old/artifacts/clearml/
old/artifacts/cml_audit/
old/artifacts/kaggle_*/

# Editor / OS
.idea/
.vscode/
*.swp
*.swo

# old/ is the legacy CatBoost pipeline — not needed inside the racformer image
# We DO keep old/artifacts/formation_b2_*/ (b2 prior parquet) at runtime via volume mount.
old/__pycache__/
old/rogii/
old/tests/
old/configs/
old/.venv/
old/.kaggle_mining/
