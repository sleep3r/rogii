# Copy to portainer.yml and fill secrets locally. portainer.yml is gitignored.

CLEAR_ML_CONF_PATH: ~/clearml.conf

# REGISTRY_USERNAME is used by spacebridge to generate an image tag when
# IMAGE_NAME has no explicit tag.
REGISTRY_USERNAME: <service-account-or-username>
IMAGE_NAME: harbor.wildberries.ru/tns-backoffice-security/rogii/train

INSTANCES:
  gpu:
    PORTAINER_URL: https://<portainer-host>:9443
    PORTAINER_ACCESS_KEY: <access_key>

DEVICE_IDS: [0]
SHARED_MEMORY_SIZE: 17179869184
